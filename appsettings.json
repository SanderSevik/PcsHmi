{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Pcs": {
    "PortName": "/dev/ttyACM0",
    "BaudRate": 9600,
    "DatabasePath": "pcs.db",
    "LogIntervalSeconds": 5,
    "HighTempLimitC": 28.0,
    "LowTempLimitC": 15.0,
    "AlarmHysteresisC": 0.5,
    "CommTimeoutSeconds": 5
  }
}
